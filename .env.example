# URL publique du site vitrine (utilisee pour les metadonnees, le sitemap et l'OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.juristia.fr

# URL de l'application metier existante (bouton "Se connecter" / "Espace client")
NEXT_PUBLIC_APP_URL=https://app.juristia.fr

# Adresse de contact commerciale (CTA "Demander une demonstration")
NEXT_PUBLIC_CONTACT_EMAIL=contact@juristia.fr

# Reception des demandes de demonstration (optionnel).
# Cle ANON uniquement -- JAMAIS la cle service_role, qui contourne la RLS.
# Sans ces variables, le formulaire bascule sur un envoi par e-mail.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
